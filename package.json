{
  "name": "ctr-cms",
  "private": true,
  "version": "0.1.0",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ctr-cms/admin",
    "server": "npm run dev --workspace @ctr-cms/server",
    "db:init": "psql -U ctrcms -d ctrcms -f supabase/migrations/000_custom_auth_pg.sql",
    "db:seed": "psql -U ctrcms -d ctrcms -f supabase/seed.sql",
    "mobile": "npm run start --workspace @ctr-cms/mobile",
    "mobile:apk": "npm run build:apk --workspace @ctr-cms/mobile",
    "mobile:android": "npm run build:android --workspace @ctr-cms/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:phase1": "tsx --test tests/phase-1.test.ts",
    "test:phase2": "tsx --test tests/phase-2.test.ts",
    "test:phase3": "tsx --test tests/phase-3.test.ts",
    "test:phase4": "tsx --test tests/phase-4.test.ts",
    "test:phase5": "tsx --test tests/phase-5.test.ts",
    "test:phase6": "tsx --test tests/phase-6.test.ts",
    "test:phase7": "tsx --test tests/phase-7.test.ts",
    "test:phase8": "tsx --test tests/phase-8.test.ts",
    "test:phase9": "tsx --test tests/phase-9.test.ts",
    "test:phase10": "tsx --test tests/phase-10.test.ts",
    "test:phase11": "tsx --test tests/phase-11.test.ts",
    "test:phase12": "tsx --test tests/phase-12.test.ts",
    "test:phase13": "tsx --test tests/phase-13.test.ts",
    "test:all": "npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11 && npm run test:phase12 && npm run test:phase13"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
