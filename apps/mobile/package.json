{
  "name": "@ctr-cms/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "npx eas build --platform android --profile preview",
    "build:android": "npm run build:apk",
    "build:android:local": "npx expo prebuild --clean --platform android && cd android && ./gradlew assembleRelease",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ctr-cms/shared": "*",
    "@expo/metro-runtime": "~5.0.5",
    "expo": "~53.0.0",
    "expo-image-picker": "~16.1.4",
    "expo-status-bar": "~2.2.0",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-web": "^0.20.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.0",
    "eas-cli": "^16.0.0",
    "typescript": "^5.8.3"
  }
}
