# Database (PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGDATABASE=ctrcms
PGUSER=ctrcms
PGPASSWORD=ctrcms123

# API server
PORT=4200
JWT_SECRET=ctr-cms-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Mobile/admin API endpoint
EXPO_PUBLIC_API_URL=http://localhost:4200/api
NEXT_PUBLIC_API_URL=http://localhost:4200/api

# OTP delivery provider: 'mock' (dev) or 'email' (Gmail SMTP, real OTP by email)
SMS_PROVIDER=email

# Email (Gmail SMTP) — required when SMS_PROVIDER=email
# Gmail App Password: Google account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=  # your full Gmail address, e.g. you@gmail.com
SMTP_PASS=  # the 16-char Gmail App Password (not your normal password)
EMAIL_FROM= # optional, defaults to SMTP_USER

# MSG91 (https://control.msg91.com) — used only when SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Set NODE_ENV=production in a deployed environment to stop returning devOtp
NODE_ENV=development
